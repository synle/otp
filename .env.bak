# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.bak` is the template that ships with the repo.

# Required in production. Signs the __session and __auth_state cookies.
# Generate with: openssl rand -hex 32
# In dev, falls back to AAD_SSO_CLIENT_VALUE then a known literal "s3cret1".
SESSION_SECRET="some_value"

# Microsoft / Azure AD
AAD_SSO_TENANT_ID="common"
AAD_SSO_CLIENT_ID="some_value"
AAD_SSO_CLIENT_VALUE="some_value"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_OAUTH_CLIENT_ID="some_value"
GOOGLE_OAUTH_CLIENT_SECRET="some_value"

# Optional: per-provider redirect URI overrides. The IdP-side app
# registration enforces an exact-match check against these.
# MICROSOFT_REDIRECT_URL="https://your-host/api/auth/microsoft/login_callback"
# GOOGLE_REDIRECT_URL="https://your-host/api/auth/google/login_callback"

# Optional: origin used to build redirect URIs when no per-provider
# override is set. Useful behind a tunnel / reverse proxy.
# AUTH_BASE_HOST_URL="https://your-host"

# Optional: where to keep the SQLite OTP database.
# Absolute is used as-is; relative resolves against cwd.
# Defaults to `${cwd}/otp.db` if unset. On Azure App Service, set this
# to /home/site/data/otp.db so the file lives on the persistent mount.
# OTP_DB_PATH="/home/site/data/otp.db"
